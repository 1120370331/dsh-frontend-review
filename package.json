{
  "name": "dsh-frontend-review",
  "version": "0.2.0",
  "description": "Frontend review canvas for DeepSeek Harness: pin page versions on an infinite canvas, annotate screenshots, and route visual feedback back into the bound conversation.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "skills",
    "demo",
    "docs",
    "standalone",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "frontend",
    "design-review",
    "visual-feedback",
    "canvas"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "author": "1120370331",
  "repository": {
    "type": "git",
    "url": "https://github.com/1120370331/dsh-frontend-review.git"
  },
  "homepage": "https://github.com/1120370331/dsh-frontend-review#readme",
  "bugs": {
    "url": "https://github.com/1120370331/dsh-frontend-review/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
